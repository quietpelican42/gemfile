# frozen_string_literal: true
gem "double", "~> 1.0" # trailing comment
gem %q(percent-q), %Q[1.0]
gem 'multi',
    '>= 1.0',
    '< 2.0',
    require: false,
    group: %i[a b]
gem('parens', '1.0', { :require => false })
gem 'words', groups: %w[x y]
gem 'with-hash-rocket' , :group => :z , "platform" => :ruby
gem 'semi'; gem 'colon'
gem 'adjacent' '-name'
gem 'escapes', require: "a\tb\\c\u00e9"
gem 'quoted-labels', 'group': :dev, "require": false

=begin
gem 'commented-out'
=end
gem 'trailing-comma',
    '1.0',
    require: 'x'
